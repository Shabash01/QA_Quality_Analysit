# PROJECT Bug Escape & QA 
create database QA_Quality_Analyzer;

use QA_Quality_Analyzer;

Create table Projects (
Project_ID int primary key,
Project_Name varchar(50),
Application_Type varchar(50),
Start_Date date
);

create table Test_Cases (
TestCase_ID int primary key,
Project_ID int, 
TestCase_Name varchar(50),
Test_Type varchar(50),
Priority varchar(50)
);


create table Test_Executions (
Execution_ID Int primary key,
TestCase_ID int,
Execution_Date date,
Status ENUM('Pass','Fail','Blocked'),
Environment ENUM('QA','Pre-Prod','Prod')
);

create table Defects (
Project_ID int primary key,
Execution_ID int,
Severity Enum ('Critical','Major','Minor'),
Found_Environment varchar(20),
Defect_Status varchar (20)
);
alter table defects drop Project_id;
alter table defects add Project_ID int;
