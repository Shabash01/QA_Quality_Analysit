#1. The QA lead needs a list of Critical and Major defects that are still Open, sorted by severity and then by discovery environment.

select * from defects 
where severity in ('critical', 'major') and defect_status = 'Open' and Project_id = 1
order by severity, Found_Environment;

# 2. Release management wants to identify all test executions that failed in Pre-Prod or Prod during September 2026.
select * from test_executions
where status = 'Fail' and Environment in ('pre-prod', 'prod')
and execution_date >= '2026-09-01' and execution_date <='2026-10-01';

#3. The QA manager needs a list of unique environments in which defects have been discovered, to standardize environment reporting.
select distinct Found_environment from defects;

#4. Identify test cases whose names contain the words 'Payment', 'Login', or 'Search' so the team can review high-risk workflows.
select * from test_cases 
where testcase_name like '%login%' 
or testcase_name like '%Payment%'
or testcase_name like '%Search%';

#5. Find test executions that are Blocked or have not yet been assigned an execution status, for the daily QA follow-up report.
select * from test_executions
where status = 'Blocked' or null;

#6. Identify test cases marked High priority that belong to Functional, Regression, or Security testing.
select * from test_cases
where test_type in ('Functional', 'Regression', 'Security') and priority = 'High';

#7. The QA manager wants the total number of test cases for each project, with the projects having the largest test suites shown first.
select count(TestCase_Id) as tota_tescase_count, Project_id from test_cases
group by project_id
order by tota_tescase_count desc;

#8. Calculate the Pass, Fail, and Blocked execution counts for each environment to assess environment stability.
select environment,
sum(case when status = 'pass' then 1 else 0 end) As Pass_count,
sum(case when status = 'Fail' then 1 else 0 end) As Fail_count, 
sum(case when status = 'Block' then 1 else 0 end) As block_count
From test_executions
group by environment;

#9. Calculate the pass percentage for each project. Exclude blocked executions from the pass-rate denominator and explain your calculation.
select project_id,
       ROUND(100.0 * SUM(case when status = 'Pass' then 1 else 0 end)
             / NULLIF(SUM(case when status <> 'Blocked' then 1 else 0 end), 0), 2) as pass_pct
from test_executions
group by project_id;

#10. The release manager wants to find projects with more than 10 recorded test executions that have at least one failure.
select project_id, COUNT(*) AS total_executions
from test_executions
group by project_id
HAVING COUNT(*) > 10
   AND SUM(case when status = 'Fail' then 1 else 0 end) >= 1;

#11. Calculate the number of Open defects by severity and environment, so the team can prioritize its workload.
select severity, Found_environment, COUNT(*) AS open_defects
from defects
where Defect_Status = 'Open'
group by severity, Found_environment
order By open_defects desc;

#12. Find projects whose average number of executions per test case is greater than the overall average across projects.
with  per_project AS (
    select project_id,
           COUNT(*) * 1.0 / COUNT(DISTINCT testcase_id) AS avg_exec_per_tc
    from test_executions
    group by project_id
)
select project_id, avg_exec_per_tc
from per_project
where avg_exec_per_tc > (select avg(avg_exec_per_tc) from per_project);

#13. Calculate each project's Critical defect count, Major defect count, and total defect count for a QA leadership report.
select project_id,
       SUM(case when severity = 'Critical' then 1 else 0 end) AS critical_count,
       SUM(case when severity = 'Major' then 1 else 0 end)    AS major_count,
       COUNT(*)                                               AS total_defects
from defects
group by project_id;

#14. Produce a project quality report showing project name, total test cases, total executions, and total defects.
select p.project_name,
       COUNT(DISTINCT tc.testcase_id)  AS total_test_cases,
       COUNT(DISTINCT te.execution_id) AS total_executions,
       COUNT(DISTINCT d.defect_id)     AS total_defects
from projects p
LEFT JOIN test_cases tc      ON tc.project_id = p.project_id
LEFT JOIN test_executions te ON te.testcase_id = tc.testcase_id
LEFT JOIN defects d          ON d.project_id = p.project_id
GROUP BY p.project_name;

#15. Identify test cases that have never been executed, so QA can improve test coverage.
select tc.testcase_id, tc.testcase_name
from test_cases tc
LEFT JOIN test_executions te ON te.testcase_id = tc.testcase_id
WHERE te.execution_id IS NULL;

#16. Identify projects that have no recorded defects, while ensuring projects with no executions are still considered.
SELECT p.project_id, p.project_name
FROM projects p
LEFT JOIN defects d ON d.project_id = p.project_id
WHERE d.defect_id IS NULL;

#17. Find defects whose recorded discovery environment differs from the environment of the linked test execution. These records need investigation.
select d.defect_id, d.Found_environment, te.execution_id, te.environment
from defects d
JOIN test_executions te ON te.execution_id = d.execution_id
WHERE d.Found_environment <> te.environment;

#18. Generate a defect investigation report containing project name, test case name, execution date, execution status, defect severity, and defect status.
select p.project_name, tc.testcase_name, te.execution_date,
       te.status AS execution_status, d.severity, d.Defect_Status
from defects d
JOIN test_executions te ON te.execution_id = d.execution_id
JOIN test_cases tc      ON tc.testcase_id = te.testcase_id
JOIN projects p         ON p.project_id = tc.project_id
ORDER BY p.project_name, te.execution_date;

#19. Produce one combined list of project names and test case names for a reporting export, removing duplicate text values.
select project_name AS name from projects
UNION
select testcase_name from test_cases
ORDER BY name;

#20. Identify test executions that do not have a corresponding defect record. Present these as executions with no linked defect record, not automatically as successful tests.
select project_name AS name FROM projects
UNION
select testcase_name from test_cases
ORDER BY name;

#21. Categorize projects as 'High Risk', 'Medium Risk', or 'Low Risk' based on their Open Critical and Major defect counts. Define your thresholds before writing the query.
WITH counts AS (
    SELECT p.project_id, p.project_name,
           SUM(CASE WHEN d.severity = 'Critical' THEN 1 ELSE 0 END) AS open_critical,
           SUM(CASE WHEN d.severity = 'Major' THEN 1 ELSE 0 END)    AS open_major
    FROM projects p
    LEFT JOIN defects d ON d.project_id = p.project_id
                       AND d.Defect_Status = 'Open'
    GROUP BY p.project_id, p.project_name
)
SELECT project_name, open_critical, open_major,
       CASE WHEN open_critical >= 2 OR open_major >= 5 THEN 'High Risk'
            WHEN open_critical = 1 OR open_major >= 2  THEN 'Medium Risk'
            ELSE 'Low Risk' END AS risk_level
FROM counts;

#22. Find projects whose defect count is greater than the average defect count per project.
WITH per_project AS (
    SELECT p.project_id, p.project_name, COUNT(d.defect_id) AS defect_count
    FROM projects p
    LEFT JOIN defects d ON d.project_id = p.project_id
    GROUP BY p.project_id, p.project_name
)
SELECT project_name, defect_count
FROM per_project
WHERE defect_count > (SELECT AVG(defect_count * 1.0) FROM per_project);

#23. Identify test executions with a salary-independent business rule: executions whose status is Fail and whose environment is Prod, using a subquery to identify the relevant test cases by project risk.
SELECT te.*
FROM test_executions te
WHERE te.status = 'Fail'
  AND te.environment = 'Prod'
  AND te.testcase_id IN (
      SELECT tc.testcase_id
      FROM test_cases tc
      WHERE tc.project_id IN (
          SELECT project_id
          FROM defects
          WHERE Defect_Status = 'Open'
          GROUP BY project_id
          HAVING SUM(CASE WHEN severity = 'Critical' THEN 1 ELSE 0 END) >= 2
              OR SUM(CASE WHEN severity = 'Major' THEN 1 ELSE 0 END) >= 5
      )
  );
  
#24. Find projects that have at least one Critical defect discovered in Prod.
SELECT p.project_id, p.project_name
FROM projects p
WHERE EXISTS (
    SELECT 1 FROM defects d
    WHERE d.project_id = p.project_id
      AND d.severity = 'Critical'
      AND d.Found_environment = 'Prod'
);

#25. Find projects where every recorded defect is Closed. Decide how projects with zero defects should be handled.
SELECT p.project_id, p.project_name
FROM projects p
JOIN defects d ON d.project_id = p.project_id
GROUP BY p.project_id, p.project_name
HAVING SUM(CASE WHEN d.Defect_Status = 'Closed' THEN 0 ELSE 1 END) = 0;

#26. Identify test cases that have been executed more than once and have failed at least once, for regression investigation.
SELECT tc.testcase_id, tc.testcase_name,
       COUNT(*) AS total_runs,
       SUM(CASE WHEN te.status = 'Fail' THEN 1 ELSE 0 END) AS fail_runs
FROM test_cases tc
JOIN test_executions te ON te.testcase_id = tc.testcase_id
GROUP BY tc.testcase_id, tc.testcase_name
HAVING COUNT(*) > 1
   AND SUM(CASE WHEN te.status = 'Fail' THEN 1 ELSE 0 END) >= 1;
   
#27. Find projects whose Open Critical defect count is higher than that of every other project, returning all tied projects.
WITH crit AS (
    SELECT project_id, COUNT(*) AS open_critical
    FROM defects
    WHERE severity = 'Critical' AND Defect_Status = 'Open'
    GROUP BY project_id
)
SELECT p.project_name, c.open_critical
FROM crit c
JOIN projects p ON p.project_id = c.project_id
WHERE c.open_critical = (SELECT MAX(open_critical) FROM crit);

#28. Use CTEs to prepare a project-level report containing test-case count, execution count, pass count, and open-defect count without accidentally multiplying counts during joins.
WITH tc_counts AS (
    SELECT project_id, COUNT(*) AS test_case_count
    FROM test_cases
    GROUP BY project_id
),
exec_counts AS (
    SELECT tc.project_id,
           COUNT(*) AS execution_count,
           SUM(CASE WHEN te.status = 'Pass' THEN 1 ELSE 0 END) AS pass_count
    FROM test_executions te
    JOIN test_cases tc ON tc.testcase_id = te.testcase_id
    GROUP BY tc.project_id
),
defect_counts AS (
    SELECT project_id, COUNT(*) AS open_defect_count
    FROM defects
    WHERE Defect_Status = 'Open'
    GROUP BY project_id
)
SELECT p.project_name,
       COALESCE(t.test_case_count, 0)   AS test_case_count,
       COALESCE(e.execution_count, 0)   AS execution_count,
       COALESCE(e.pass_count, 0)        AS pass_count,
       COALESCE(d.open_defect_count, 0) AS open_defect_count
FROM projects p
LEFT JOIN tc_counts t     ON t.project_id = p.project_id
LEFT JOIN exec_counts e   ON e.project_id = p.project_id
LEFT JOIN defect_counts d ON d.project_id = p.project_id;

#29. Rank projects by the number of Open Critical defects. Projects with equal counts should receive the same rank.
SELECT p.project_name,
       COUNT(d.defect_id) AS open_critical,
       DENSE_RANK() OVER (ORDER BY COUNT(d.defect_id) DESC) AS rnk
FROM projects p
LEFT JOIN defects d ON d.project_id = p.project_id
                   AND d.severity = 'Critical'
                   AND d.Defect_Status = 'Open'
GROUP BY p.project_id, p.project_name;

#30. Find the most recent execution for every test case, even when that test case has never been executed.
WITH ranked AS (
    SELECT tc.testcase_id, tc.testcase_name,
           te.execution_id, te.execution_date, te.status,
           ROW_NUMBER() OVER (PARTITION BY tc.testcase_id
                              ORDER BY te.execution_date DESC, te.execution_id DESC) AS rn
    FROM test_cases tc
    LEFT JOIN test_executions te ON te.testcase_id = tc.testcase_id
)
SELECT testcase_id, testcase_name, execution_id, execution_date, status
FROM ranked
WHERE rn = 1;

